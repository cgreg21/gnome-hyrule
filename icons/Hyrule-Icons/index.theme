[Icon Theme]
Name=Hyrule-Icons
Comment=Detailed Hyrule pixel-art icon theme
Inherits=Adwaita,hicolor
Directories=128x128/apps,scalable/apps,scalable/places,scalable/status,scalable/mimetypes

[128x128/apps]
Size=128
Type=Fixed
Context=Applications

[scalable/apps]
Size=64
Type=Scalable
MinSize=16
MaxSize=512
Context=Applications

[scalable/places]
Size=64
Type=Scalable
MinSize=16
MaxSize=512
Context=Places

[scalable/status]
Size=64
Type=Scalable
MinSize=16
MaxSize=512
Context=Status

[scalable/mimetypes]
Size=64
Type=Scalable
MinSize=16
MaxSize=512
Context=MimeTypes
